---
# Authelia Configuration for Samba AD Integration
# Copy this file to configuration.yml and update the values

server:
  address: 'tcp://:9091'

log:
  level: 'info'

# JWT secret for identity verification
# Generate with: openssl rand -hex 32
identity_validation:
  reset_password:
    jwt_secret: 'CHANGE_ME_JWT_SECRET_32_HEX_CHARS'

# Samba AD LDAP Authentication
authentication_backend:
  ldap:
    address: 'ldap://YOUR_AD_SERVER:389'
    implementation: 'activedirectory'
    timeout: '5s'
    start_tls: false
    base_dn: 'DC=yourdomain,DC=local'
    additional_users_dn: 'OU=Users'
    users_filter: '(&(|({username_attribute}={input})({mail_attribute}={input}))(objectClass=person)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'
    additional_groups_dn: 'OU=Groups'
    groups_filter: '(&(member={dn})(objectClass=group))'
    user: 'CN=service-account,OU=Services,DC=yourdomain,DC=local'
    password: 'YOUR_SERVICE_ACCOUNT_PASSWORD'
    attributes:
      distinguished_name: 'distinguishedName'
      username: 'sAMAccountName'
      display_name: 'displayName'
      mail: 'mail'
      member_of: 'memberOf'
      group_name: 'cn'

# Session configuration
# Generate secret with: openssl rand -hex 32
session:
  secret: 'CHANGE_ME_SESSION_SECRET_32_HEX_CHARS'
  cookies:
    - domain: 'yourdomain.com'
      authelia_url: 'https://authelia.yourdomain.com'
      default_redirection_url: 'https://plane.yourdomain.com'

# Storage (SQLite for simplicity)
# Generate encryption_key with: openssl rand -hex 32
storage:
  encryption_key: 'CHANGE_ME_ENCRYPTION_KEY_32_HEX_CHARS'
  local:
    path: '/config/db.sqlite3'

# Notification (filesystem for testing, use SMTP for production)
notifier:
  filesystem:
    filename: '/config/notification.txt'
  # For production, use SMTP:
  # smtp:
  #   address: 'smtp://mail.yourdomain.com:587'
  #   username: 'authelia@yourdomain.com'
  #   password: 'YOUR_SMTP_PASSWORD'
  #   sender: 'Authelia <authelia@yourdomain.com>'

# Access control - default allow for OIDC
access_control:
  default_policy: 'one_factor'

# OIDC Provider Configuration
identity_providers:
  oidc:
    # Generate with: openssl rand -hex 32
    hmac_secret: 'CHANGE_ME_HMAC_SECRET_32_HEX_CHARS'
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        # Generate with: openssl genrsa -out oidc.pem 4096
        # Then paste the content here
        key: |
          -----BEGIN PRIVATE KEY-----
          YOUR_PRIVATE_KEY_HERE
          -----END PRIVATE KEY-----
    clients:
      - client_id: 'plane'
        client_name: 'Plane'
        # Generate with: authelia crypto hash generate pbkdf2 --variant sha512 --password 'your-client-secret'
        client_secret: '$pbkdf2-sha512$...'
        public: false
        authorization_policy: 'one_factor'
        redirect_uris:
          - 'https://plane.yourdomain.com/auth/oidc/callback/'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'groups'
        token_endpoint_auth_method: 'client_secret_basic'
