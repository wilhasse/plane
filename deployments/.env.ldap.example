# Plane with LDAP/Authelia Environment Configuration
# Copy this file to .env and update the values

# ======================
# Basic Configuration
# ======================
APP_DOMAIN=plane.yourdomain.com
APP_RELEASE=stable

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

WEB_URL=https://${APP_DOMAIN}
DEBUG=0
CORS_ALLOWED_ORIGINS=https://${APP_DOMAIN}
API_BASE_URL=http://api:8000

# ======================
# Database Settings
# ======================
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# ======================
# Redis Settings
# ======================
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# ======================
# RabbitMQ Settings
# ======================
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=

# ======================
# SSL/TLS Configuration
# ======================
# For Let's Encrypt:
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_EMAIL=admin@yourdomain.com
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80

# For DNS Challenge (optional):
# CERT_ACME_DNS="acme_dns <PROVIDER> <API_KEY>"
CERT_ACME_DNS=

# ======================
# Security Keys
# ======================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# ======================
# Object Storage (MinIO)
# ======================
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
MINIO_ENDPOINT_SSL=0

# ======================
# API Settings
# ======================
GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute

# ======================
# Live Server
# ======================
# Generate with: openssl rand -hex 24
LIVE_SERVER_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# ======================
# LDAP Configuration
# ======================
# Enable LDAP authentication (1=enabled, 0=disabled)
LDAP_ENABLED=1

# LDAP/AD Server
LDAP_SERVER=192.168.20.5
LDAP_PORT=389

# AD Domain (for authentication)
LDAP_DOMAIN=yourdomain.local

# ======================
# AD Sync Configuration
# ======================
# For ad-sync scripts
AD_SERVER=${LDAP_SERVER}
AD_PORT=${LDAP_PORT}
AD_BASE_DN=DC=yourdomain,DC=local
AD_USERS_OU=OU=Users
AD_BIND_USER=CN=service-account,OU=Services,DC=yourdomain,DC=local
AD_BIND_PASSWORD=your-service-account-password

# ======================
# HTTPS Proxy Settings
# ======================
# If behind a reverse proxy that handles SSL
CSRF_TRUSTED_ORIGINS=https://plane.yourdomain.com
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ======================
# Slack Integration (Optional)
# ======================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
